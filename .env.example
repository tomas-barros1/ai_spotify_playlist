# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Spotify User Access Token (from Spotify Web API Console / Tutorial)
# Scopes needed: playlist-modify-public, playlist-modify-private
SPOTIFY_ACCESS_TOKEN=your_spotify_token_here
