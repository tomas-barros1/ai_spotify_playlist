# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Spotify Developer Application Credentials
# 1. Create a free app at https://developer.spotify.com/dashboard
# 2. Add 'http://127.0.0.1:8888/callback' under Redirect URIs in App Settings
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Automatically saved on first login (OAuth2 refresh token):
SPOTIFY_REFRESH_TOKEN=
